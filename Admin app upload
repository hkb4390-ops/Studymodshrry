<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>studymods.hrry - Admin Panel</title>
    <style>
        :root {
            --bg-base: #0a0a0c;
            --card-bg: rgba(255, 255, 255, 0.04);
            --border-color: rgba(255, 255, 255, 0.08);
            --accent: #0A84FF;
            --text-main: #FFFFFF;
            --text-muted: #8E8E93;
        }
        
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            background: var(--bg-base);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 20px;
        }
        
        .container {
            max-width: 800px;
            margin: 0 auto;
        }
        
        h1 {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 24px;
            text-align: center;
            background: linear-gradient(135deg, #0A84FF, #5AC8FA);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
            backdrop-filter: blur(20px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .card h2 { font-size: 20px; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; }

        .form-group { margin-bottom: 16px; }
        label { display: block; font-size: 13px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; }
        
        input, select, textarea {
            width: 100%;
            padding: 14px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            color: #fff;
            font-size: 15px;
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus, select:focus, textarea:focus { border-color: var(--accent); }

        .btn {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 14px 20px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            transition: transform 0.2s, background 0.2s;
        }
        .btn:active { transform: scale(0.97); }
        .btn-update { background: #32D74B; color: #000; }
        .btn-secondary { background: #3a3a3c; margin-top: 8px; }

        .app-list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            padding: 14px;
            border-radius: 14px;
            margin-bottom: 12px;
            gap: 14px;
            transition: all 0.2s ease;
        }
        .app-list-item:hover { background: rgba(255, 255, 255, 0.05); }
        
        .app-list-info { flex: 1; min-width: 0; }
        .app-list-title { font-weight: 700; font-size: 16px; margin-bottom: 4px; color: #fff;}
        .app-list-title span { color: var(--accent); font-size: 13px; font-weight: 600; margin-left: 8px; background: rgba(10, 132, 255, 0.15); padding: 2px 6px; border-radius: 6px;}
        .app-list-title span.upcoming-tag { color: #FF9F0A; background: rgba(255, 159, 10, 0.15); }
        .app-list-sub { font-size: 13px; color: var(--text-muted); }
        
        .action-btns { display: flex; gap: 8px; flex-shrink: 0; }
        .sm-btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: transform 0.1s;
        }
        .sm-btn:active { transform: scale(0.9); }
        .edit-btn { background: #32D74B; color: #000; }
        .del-btn { background: #FF3B30; color: #fff; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Admin Control Panel</h1>

        <!-- ADD / EDIT FORM -->
        <div class="card">
            <h2 id="form-heading">Add New App</h2>
            <form id="app-form">
                <!-- Hidden inputs for Editing and Tracking -->
                <input type="hidden" id="app-id">
                <input type="hidden" id="old-node">
                
                <div class="form-group">
                    <label>App Category (जहाँ दिखाना है)</label>
                    <select id="app-category">
                        <option value="apps">Published App (Home Tab में दिखेगा)</option>
                        <option value="upcoming">Upcoming App (Upcoming Tab में दिखेगा)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Position / Order (सबसे ऊपर दिखाने के लिए 1 लिखें)</label>
                    <input type="number" id="app-order" placeholder="e.g. 1" value="1">
                </div>

                <div class="form-group">
                    <label>App Name</label>
                    <input type="text" id="app-name" required placeholder="e.g. Math Master Pro">
                </div>

                <div class="form-group">
                    <label>App Logo URL (Image Link)</label>
                    <input type="url" id="app-logo" required placeholder="https://image-link.com/logo.png">
                </div>

                <div class="form-group">
                    <label>App Link (APK Download / Web Link)</label>
                    <input type="url" id="app-link" placeholder="https://t.me/yourchannel/... or download link">
                </div>

                <div class="form-group">
                    <label>Short Description</label>
                    <textarea id="app-desc" rows="3" placeholder="Write a short description about the app..."></textarea>
                </div>

                <button type="submit" class="btn" id="save-btn">Save New App</button>
                <button type="button" class="btn btn-secondary" id="cancel-btn" style="display:none;" onclick="resetForm()">Cancel Edit Mode</button>
            </form>
        </div>

        <!-- MANAGE EXISTING APPS (EDIT / DELETE) -->
        <div class="card">
            <h2>Manage Existing Apps (Edit / Delete)</h2>
            <div id="admin-apps-list">
                <p style="color:var(--text-muted); text-align:center; padding: 20px;">Loading apps from database...</p>
            </div>
        </div>
    </div>

    <!-- FIREBASE ADMIN LOGIC -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
        import { getDatabase, ref, set, push, onValue, remove, update } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-database.js";

        const firebaseConfig = {
            apiKey: "YOUR_API_KEY",
            authDomain: "YOUR_AUTH_DOMAIN",
            databaseURL: "https://ewhe-1827a-default-rtdb.firebaseio.com/",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_STORAGE_BUCKET",
            messagingSenderId: "YOUR_MESSAGING_ID",
            appId: "YOUR_APP_ID"
        };
        
        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);

        const form = document.getElementById('app-form');
        const listContainer = document.getElementById('admin-apps-list');
        let allAdminData = { apps: {}, upcoming: {} };

        // Handle Add or Edit Form Submit
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const id = document.getElementById('app-id').value;
            const oldNode = document.getElementById('old-node').value;
            const newNode = document.getElementById('app-category').value; // 'apps' or 'upcoming'
            
            // Auto set status based on category selected
            const appStatus = newNode === 'apps' ? 'Published' : 'Upcoming';

            const appData = {
                name: document.getElementById('app-name').value,
                logo: document.getElementById('app-logo').value,
                link: document.getElementById('app-link').value,
                description: document.getElementById('app-desc').value,
                status: appStatus,
                order: Number(document.getElementById('app-order').value) || 999
            };

            try {
                if (id) {
                    // EDITING MODE
                    if (oldNode !== newNode) {
                        // If category is changed (e.g. Upcoming to Published), move data to new node
                        await remove(ref(db, `${oldNode}/${id}`));
                        await set(ref(db, `${newNode}/${id}`), appData);
                    } else {
                        // If category is same, just update
                        await update(ref(db, `${newNode}/${id}`), appData);
                    }
                    alert('App Edited & Updated Successfully!');
                } else {
                    // ADDING NEW MODE
                    const newRef = push(ref(db, newNode));
                    await set(newRef, appData);
                    alert('New App Added Successfully!');
                }
                resetForm();
            } catch (err) {
                alert("Error: " + err.message);
            }
        });

        // Real-time Data Fetching
        onValue(ref(db, 'apps'), (snapshot) => {
            allAdminData.apps = snapshot.val() || {};
            displayAllItems();
        });

        onValue(ref(db, 'upcoming'), (snapshot) => {
            allAdminData.upcoming = snapshot.val() || {};
            displayAllItems();
        });

        function displayAllItems() {
            listContainer.innerHTML = '';
            let combined = [];

            ['apps', 'upcoming'].forEach(node => {
                const items = allAdminData[node];
                if (items) {
                    Object.keys(items).forEach(key => {
                        combined.push({ id: key, node: node, ...items[key] });
                    });
                }
            });

            combined.sort((a, b) => (Number(a.order) || 999) - (Number(b.order) || 999));

            if (combined.length === 0) {
                listContainer.innerHTML = `<p style="color:var(--text-muted); text-align:center;">No apps found in the database.</p>`;
                return;
            }

            combined.forEach(item => {
                const isUpcoming = item.node === 'upcoming';
                const nodeLabel = isUpcoming ? 'Upcoming' : 'Published';
                const badgeClass = isUpcoming ? 'upcoming-tag' : '';
                
                listContainer.innerHTML += `
                    <div class="app-list-item">
                        <div class="app-list-info">
                            <div class="app-list-title">
                                [Order: ${item.order || '999'}] ${item.name} <span class="${badgeClass}">${nodeLabel}</span>
                            </div>
                            <div class="app-list-sub">${item.description || 'No description provided.'}</div>
                        </div>
                        <div class="action-btns">
                            <button class="sm-btn edit-btn" onclick="window.editApp('${item.node}', '${item.id}')">Edit</button>
                            <button class="sm-btn del-btn" onclick="window.deleteApp('${item.node}', '${item.id}')">Delete</button>
                        </div>
                    </div>
                `;
            });
        }

        // EDIT FUNCTIONALITY
        window.editApp = (node, id) => {
            const item = allAdminData[node][id];
            
            document.getElementById('app-id').value = id;
            document.getElementById('old-node').value = node; // Track where it was originally
            document.getElementById('app-category').value = node;
            
            document.getElementById('app-name').value = item.name || '';
            document.getElementById('app-logo').value = item.logo || '';
            document.getElementById('app-link').value = item.link || '';
            document.getElementById('app-desc').value = item.description || '';
            document.getElementById('app-order').value = item.order || 1;

            document.getElementById('form-heading').innerText = `Editing: ${item.name}`;
            document.getElementById('form-heading').style.color = "#32D74B";
            
            const saveBtn = document.getElementById('save-btn');
            saveBtn.innerText = "Update App Details";
            saveBtn.classList.add("btn-update");
            
            document.getElementById('cancel-btn').style.display = "block";
            window.scrollTo({ top: 0, behavior: 'smooth' });
        };

        // DELETE FUNCTIONALITY
        window.deleteApp = (node, id) => {
            if(confirm('Are you absolutely sure you want to delete this app?')) {
                remove(ref(db, `${node}/${id}`));
            }
        };

        // RESET FORM
        window.resetForm = () => {
            document.getElementById('app-form').reset();
            document.getElementById('app-id').value = '';
            document.getElementById('old-node').value = '';
            
            document.getElementById('form-heading').innerText = "Add New App";
            document.getElementById('form-heading').style.color = "var(--text-main)";
            
            const saveBtn = document.getElementById('save-btn');
            saveBtn.innerText = "Save New App";
            saveBtn.classList.remove("btn-update");
            
            document.getElementById('cancel-btn').style.display = "none";
        };
    </script>
</body>
</html>
